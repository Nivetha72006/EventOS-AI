# Environment & Server Port
PORT=5000
NODE_ENV=production

# Frontend Origin URL (Replace with your deployed frontend URL on Vercel / Netlify)
FRONTEND_URL=https://eventos-frontend.vercel.app
ALLOWED_ORIGINS=https://eventos-frontend.vercel.app,http://localhost:5173

# Database Connection (PostgreSQL / Supabase / Neon / Render Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventos_db

# AI & JWT Keys
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=your_jwt_secret_key_here